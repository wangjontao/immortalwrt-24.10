#!/bin/sh

CACHE=/tmp/juliang-dashboard-egress.state
CONFIG=/tmp/fastacl252/singbox.json
INTERVAL=30

cache_value() {
	sed -n "s/^$1=//p" "$CACHE" 2>/dev/null | tail -n 1
}

active_tag() {
	pidof sing-box >/dev/null 2>&1 || return 0
	[ -f "$CONFIG" ] || return 0

	for candidate in $(jsonfilter -i "$CONFIG" -e '@.outbounds[*].tag' 2>/dev/null); do
		case "$candidate" in
			node-[A-Za-z0-9_.-]*) echo "$candidate" ;;
		esac
	done | tail -n 1
}

write_cache() {
	local source="$1"
	local trace="$2"
	local ip country colo updated tmp

	ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p' | head -n 1)
	country=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p' | head -n 1)
	colo=$(printf '%s\n' "$trace" | sed -n 's/^colo=//p' | head -n 1)
	updated=$(date +%s)
	[ -n "$ip" ] && [ -n "$country" ] || return 1

	tmp="${CACHE}.$$"
	{
		printf 'source=%s\n' "$source"
		printf 'ip=%s\n' "$ip"
		printf 'country=%s\n' "$country"
		printf 'colo=%s\n' "$colo"
		printf 'updated=%s\n' "$updated"
	} > "$tmp" && mv -f "$tmp" "$CACHE"
}

sleep 5
while true; do
	tag=$(active_tag)
	if [ -n "$tag" ]; then
		source="proxy:$tag"
		trace=$(/usr/bin/sing-box tools fetch -c "$CONFIG" -o "$tag" \
			https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)
	else
		source=direct
		trace=$(curl -4 -m 5 -s \
			https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)
	fi

	write_cache "$source" "$trace" || true
	sleep "$INTERVAL"
done
