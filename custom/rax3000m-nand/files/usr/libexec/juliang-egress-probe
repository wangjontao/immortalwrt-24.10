#!/bin/sh

CACHE=/tmp/juliang-dashboard-egress.state
CONFIG=/tmp/fastacl252/singbox.json
INTERVAL=30

active_tags() {
	pidof sing-box >/dev/null 2>&1 || return 0
	[ -f "$CONFIG" ] || return 0

	for candidate in $(jsonfilter -i "$CONFIG" -e '@.outbounds[*].tag' 2>/dev/null); do
		case "$candidate" in
			node-[A-Za-z0-9_.-]*) echo "$candidate" ;;
		esac
	done | awk '!seen[$0]++'
}

write_entry() {
	local key="$1"
	local trace="$2"
	local ip country colo updated

	ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p' | head -n 1)
	country=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p' | head -n 1)
	colo=$(printf '%s\n' "$trace" | sed -n 's/^colo=//p' | head -n 1)
	updated=$(date +%s)
	[ -n "$ip" ] && [ -n "$country" ] || return 1

	printf '%s.ip=%s\n' "$key" "$ip"
	printf '%s.country=%s\n' "$key" "$country"
	printf '%s.colo=%s\n' "$key" "$colo"
	printf '%s.updated=%s\n' "$key" "$updated"
}

preserve_entry() {
	local prefix="$1."
	[ -f "$CACHE" ] || return 0
	awk -F= -v prefix="$prefix" 'index($0, prefix) == 1' "$CACHE"
}

sleep 5
while true; do
	tags=$(active_tags)
	tmp="${CACHE}.$$"
	: > "$tmp"

	if [ -n "$tags" ]; then
		for tag in $tags; do
			trace=$(/usr/bin/sing-box tools fetch -c "$CONFIG" -o "$tag" \
				https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)
			write_entry "$tag" "$trace" >> "$tmp" ||
				preserve_entry "$tag" >> "$tmp"
		done
	else
		trace=$(curl -4 -m 5 -s \
			https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)
		write_entry direct "$trace" >> "$tmp" ||
			preserve_entry direct >> "$tmp"
	fi

	mv -f "$tmp" "$CACHE"
	sleep "$INTERVAL"
done
