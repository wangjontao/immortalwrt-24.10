#!/bin/sh
# First-boot provisioning for the NPS tunnel only.
#
# The original version also renamed the SSIDs to DulWiFi-2.4G/5G with the key
# "password" sixty seconds after boot, which overwrote the JuLiang OS branding
# and the 66668888 passphrase. Wireless is now owned by /etc/init.d/juliang-wifi;
# this script no longer touches /etc/config/wireless.

[ -e /etc/dulwifi-firstboot.done ] && exit 0

logger -t dulwifi 'first-boot NPS provisioning starting'

valid_mac() {
    printf '%s\n' "$1" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$' &&
        [ "$1" != '00:00:00:00:00:00' ] && [ "$1" != 'ff:ff:ff:ff:ff:ff' ]
}

mac=''
tries=0
while ! valid_mac "$mac"; do
    dev="$(uci -q get network.wan.device || uci -q get network.wan.ifname || true)"
    case "$dev" in @*) dev="$(uci -q get network.${dev#@}.device || true)";; esac
    [ -n "$dev" ] || dev="$(ip route 2>/dev/null | awk '/default/ {print $5; exit}')"
    if [ -n "$dev" ] && [ -r "/sys/class/net/$dev/address" ]; then
        mac="$(cat "/sys/class/net/$dev/address")"
    fi
    if ! valid_mac "$mac" && [ -n "$dev" ]; then
        for lower in /sys/class/net/"$dev"/lower_*; do
            [ -r "$lower/address" ] || continue
            mac="$(cat "$lower/address")"
            valid_mac "$mac" && break
        done
    fi
    valid_mac "$mac" && break
    tries=$((tries+1))
    [ "$tries" -lt 60 ] || { logger -t dulwifi 'WAN MAC unavailable; retry next boot'; exit 1; }
    sleep 2
done

if [ -f /etc/config/nps ] && [ -x /etc/init.d/nps ]; then
    uci -q get nps.@nps[0] >/dev/null || uci add nps nps >/dev/null
    uci set nps.@nps[0].enabled='1'
    uci set nps.@nps[0].server_addr='nps.jontao.top'
    uci set nps.@nps[0].server_port='8024'
    uci set nps.@nps[0].protocol='tcp'
    uci set nps.@nps[0].compress='1'
    uci set nps.@nps[0].crypt='1'
    uci set nps.@nps[0].vkey="$(printf '%s' "$mac" | tr -d ':' | tr '[:lower:]' '[:upper:]')"
    uci commit nps
    /etc/init.d/nps enable 2>/dev/null
    /etc/init.d/nps restart 2>/dev/null
fi

touch /etc/dulwifi-firstboot.done
logger -t dulwifi 'first-boot NPS provisioning complete'
exit 0
