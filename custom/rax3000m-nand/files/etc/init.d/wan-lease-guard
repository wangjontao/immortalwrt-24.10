#!/bin/sh /etc/rc.common
# Supervises the WAN DHCP lease guard (see /usr/libexec/wan-lease-guard).
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/wan-lease-guard
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
