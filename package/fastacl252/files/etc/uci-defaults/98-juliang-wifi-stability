#!/bin/sh
set -eu

marker=/etc/config/.fastacl-wifi-stability-261
[ -e "$marker" ] && exit 0

changed=0
for radio in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
  band=$(uci -q get "wireless.$radio.band" || true)
  channel=$(uci -q get "wireless.$radio.channel" || true)
  htmode=$(uci -q get "wireless.$radio.htmode" || true)

  case "$band" in
    5g|5ghz)
      case "$channel" in ''|48)
        uci set "wireless.$radio.channel=36"; changed=1;;
      esac
      case "$htmode" in ''|HE160|VHT160)
        uci set "wireless.$radio.htmode=HE80"; changed=1;;
      esac
      ;;
    2g|2.4g|2ghz)
      case "$channel" in ''|9)
        uci set "wireless.$radio.channel=1"; changed=1;;
      esac
      case "$htmode" in ''|HE40|VHT40)
        uci set "wireless.$radio.htmode=HE20"; changed=1;;
      esac
      ;;
  esac

  if [ -n "$band" ] && [ "$(uci -q get "wireless.$radio.country" || true)" != CN ]; then
    uci set "wireless.$radio.country=CN"
    changed=1
  fi
done

[ "$changed" = 0 ] || uci commit wireless
touch "$marker"
exit 0
