{
  "juliang-bbr": {
    "description": "JuLiang OS BBR TCP acceleration",
    "read": {
      "uci": [
        "juliang_bbr"
      ],
      "file": {
        "/usr/libexec/juliang-bbr": [
          "exec"
        ],
        "/tmp/juliang-bbr.log": [
          "read"
        ]
      },
      "ubus": {
        "session": [
          "access",
          "get"
        ],
        "luci": [
          "getFeatures"
        ]
      }
    },
    "write": {
      "uci": [
        "juliang_bbr"
      ]
    }
  }
}
