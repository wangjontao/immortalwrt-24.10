#!/bin/sh /etc/rc.common

START=95

boot() {
	local current

	# A preserved overlay can shadow the managed UI files from the new
	# read-only rootfs. Refresh them once per UI asset revision.
	if [ "$(uci -q get fastacl252.main.ui_assets)" != 'juliang-1.5-r2' ]; then
		for file in \
			/usr/share/luci/menu.d/luci-base.json \
			/usr/share/ucode/luci/template/themes/juliang/header.ut \
			/usr/share/ucode/luci/template/themes/juliang/footer.ut \
			/usr/share/ucode/luci/template/themes/juliang/sysauth.ut \
			/usr/lib/lua/luci/controller/juliang_center.lua \
			/usr/lib/lua/luci/view/fastacl252/console.htm \
			/usr/lib/lua/luci/view/fastacl252/live13.htm \
			/usr/lib/lua/luci/view/juliang_center/home.htm \
			/usr/lib/lua/luci/view/juliang_center/wireless.htm \
			/www/luci-static/juliang/cascade.css \
			/www/luci-static/juliang/juliang.css \
			/www/luci-static/juliang/mobile.css \
			/www/luci-static/resources/menu-juliang.js
		do
			[ -f "/rom$file" ] || continue
			mkdir -p "$(dirname "$file")"
			cp -f "/rom$file" "$file"
		done
		uci -q set fastacl252.main.ui_assets='juliang-1.5-r2'
		uci -q commit fastacl252
	fi

	# Migrate a provisioned pre-1.5 overlay to the tuned Argon interface once.
	if [ "$(uci -q get fastacl252.main.ui_migration)" != '1.5-juliang' ] &&
	   [ "$(uci -q get fastacl252.main.version)" = '1.5' ]; then
		uci -q set luci.themes.JuLiang='/luci-static/juliang'
		uci -q set luci.main.mediaurlbase='/luci-static/juliang'
		uci -q set luci.main.lang='zh_cn'
		uci -q commit luci
		uci -q set fastacl252.main.ui_migration='1.5-juliang'
		uci -q commit fastacl252
	fi

	current="$(uci -q get luci.main.mediaurlbase)"
	rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*

	[ -f "/www${current}/cascade.css" ] && return 0

	uci -q set luci.themes.JuLiang='/luci-static/juliang'
	uci -q set luci.main.mediaurlbase='/luci-static/juliang'
	uci -q set luci.main.lang='zh_cn'
	uci -q commit luci
}
