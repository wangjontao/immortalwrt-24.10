{#
 JuLiang OS secure login template
-#}

{% include('header', { blank_page: true }) %}

<main class="juliang-login-page">
	<section class="juliang-login-panel" aria-labelledby="juliang-login-title">
		<header class="juliang-login-brand">
			<span class="juliang-brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24"><circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h3a3 3 0 0 0 3-3V8a3 3 0 0 1 3-3"/><path d="m5 17 1 2-2 1"/></svg>
			</span>
			<span class="juliang-login-brand-copy">
				<strong><b>JuLiang</b> OS</strong>
				<small>Secure Network Console</small>
			</span>
			<span class="juliang-version-tag">v2.8.5</span>
		</header>

		<div class="juliang-login-divider"><span>SECURE CONSOLE</span></div>
		<h1 id="juliang-login-title">进入<span>控制台</span></h1>
		<p class="juliang-login-copy">使用管理员凭据登录 JuLiang OS，管理 S20L 的 WiFi、网络出口和安全分流策略。</p>

		{% if (fuser): %}
		<div class="alert-message error">
			{{ _('Invalid username and/or password! Please try again.') }}
		</div>
		{% endif %}

		<form method="post" id="juliang-login-form">
			<label class="juliang-login-label" for="luci_username">管理员账户</label>
			<div class="juliang-input-wrap">
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
				<input name="luci_username" id="luci_username" type="text" autocomplete="username" value="{{ entityencode(duser, true) }}">
			</div>

			<label class="juliang-login-label" for="luci_password">登录密码</label>
			<div class="juliang-input-wrap">
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg>
				<input name="luci_password" id="luci_password" type="password" autocomplete="current-password" placeholder="请输入管理密码">
				<button class="juliang-reveal" id="juliang-reveal" type="button" aria-label="显示密码">显示</button>
			</div>

			<button class="juliang-login-button" type="submit">{{ _('Log in') }}</button>
		</form>

		<footer class="juliang-login-foot">
			<span><i></i>安全认证已启用</span>
			<span>S20L · LOCAL ROUTER</span>
		</footer>
		<span class="juliang-login-corner">JULIANG / 0285</span>
	</section>
</main>

<script>
	(function () {
		'use strict';
		var password = document.getElementById('luci_password');
		var reveal = document.getElementById('juliang-reveal');
		reveal.addEventListener('click', function () {
			var showing = password.type === 'text';
			password.type = showing ? 'password' : 'text';
			reveal.textContent = showing ? '显示' : '隐藏';
			reveal.setAttribute('aria-label', showing ? '显示密码' : '隐藏密码');
			password.focus();
		});
		password.focus();
	})();
</script>

{% include('footer', { blank_page: true }) %}
