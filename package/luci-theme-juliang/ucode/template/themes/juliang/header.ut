{#
 JuLiang OS v1.5 LuCI shell
 Based on the LuCI Bootstrap template structure, Apache-2.0
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? 'JuLiang OS');
	const loginUser = ctx.authuser ?? '';
	const limitedAdmin = loginUser === 'admin';
	const routeTitles = {
		'': 'JuLiang OS 监测中心',
		'admin-juliang-home': 'JuLiang OS 监测中心',
		'admin-juliang-wireless': '无线设备管理',
		'admin-juliang-fastacl': 'JuLiang OS 控制台',
		'admin-juliang-bbr': 'BBR TCP 加速',
		'admin-system-nps': 'JuLiang OS 管理',
		'admin-status-overview': '状态概览'
	};
	const routeKey = join('-', ctx.request_path);
	const pageTitle = routeTitles[routeKey] ?? striptags(node?.title ?? '运行总览');

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="true">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="theme-color" content="#07131f">
		<title>{{ pageTitle }} - JuLiang OS</title>
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="stylesheet" href="{{ media }}/juliang.css?v=1.5-r4">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="juliang-theme lang_{{ dispatcher.lang }} {{ ctx.authsession ? 'logged-in' : 'login-page' }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<aside class="juliang-sidebar" id="juliang-sidebar" aria-label="JuLiang OS 主导航">
			<div class="juliang-brand-panel">
				<a class="juliang-brand" href="{{ dispatcher.build_url('admin/juliang/home') }}">
					<span class="juliang-brand-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24"><circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h3a3 3 0 0 0 3-3V8a3 3 0 0 1 3-3"/><path d="m5 17 1 2-2 1"/></svg>
					</span>
					<span class="juliang-brand-copy">
						<strong><b>JuLiang</b> OS</strong>
						<small>Network Control Console</small>
					</span>
					<span class="juliang-version-tag">v1.5</span>
				</a>
				<div class="juliang-system-card">
					<div>
						<span class="juliang-online-dot"></span>
						<strong>系统在线</strong>
					</div>
					<span>{{ hostname }}</span>
					<small>DUAL BAND WIFI</small>
					<div class="juliang-proxy-list" id="juliang-proxy-list">
						<div class="juliang-proxy-row">
							<span>当前代理 IP</span>
							<strong id="juliang-proxy-ip">检测中</strong>
							<small id="juliang-proxy-location">正在识别地区</small>
						</div>
					</div>
				</div>
			</div>
			<div class="juliang-nav-caption">控制台</div>
			<ul class="nav" id="topmenu">
				<li data-nav-prefix="/cgi-bin/luci/admin/home">
					<a href="{{ dispatcher.build_url('admin','home') }}"><span class="juliang-nav-glyph" aria-hidden="true"></span><span class="juliang-nav-title">首页</span></a>
				</li>
				{% if (!limitedAdmin): %}
				<li class="dropdown" data-nav-prefix="/cgi-bin/luci/admin/status">
					<a class="menu" href="#"><span class="juliang-nav-glyph" aria-hidden="true"></span><span class="juliang-nav-title">状态概览</span><span class="juliang-nav-chevron" aria-hidden="true">›</span></a>
					<ul class="dropdown-menu">
						<li><a href="{{ dispatcher.build_url('admin','status','overview') }}">概览</a></li>
						<li><a href="{{ dispatcher.build_url('admin','status','routes') }}">路由</a></li>
						<li><a href="{{ dispatcher.build_url('admin','status','nftables') }}">防火墙状态</a></li>
						<li><a href="{{ dispatcher.build_url('admin','status','logs') }}">系统日志</a></li>
						<li><a href="{{ dispatcher.build_url('admin','status','processes') }}">进程</a></li>
						<li><a href="{{ dispatcher.build_url('admin','status','realtime') }}">实时图表</a></li>
					</ul>
				</li>
				<li class="dropdown" data-nav-prefix="/cgi-bin/luci/admin/system">
					<a class="menu" href="#"><span class="juliang-nav-glyph" aria-hidden="true"></span><span class="juliang-nav-title">系统管理</span><span class="juliang-nav-chevron" aria-hidden="true">›</span></a>
					<ul class="dropdown-menu">
						<li><a href="{{ dispatcher.build_url('admin','system','system') }}">系统</a></li>
						<li><a href="{{ dispatcher.build_url('admin','system','nps') }}">JuLiang OS 管理</a></li>
						<li><a href="{{ dispatcher.build_url('admin','system','admin') }}">管理权</a></li>
						<li><a href="{{ dispatcher.build_url('admin','system','flash') }}">备份与更新</a></li>
						<li><a href="{{ dispatcher.build_url('admin','system','reboot') }}">重启</a></li>
						<li><a href="{{ dispatcher.build_url('admin','system','leds') }}">LED 配置</a></li>
						<li><a href="{{ dispatcher.build_url('admin','system','ttyd') }}">终端</a></li>
						<li><a href="{{ dispatcher.build_url('admin','system','autoreboot') }}">定时重启</a></li>
					</ul>
				</li>
				{% endif %}
				<li class="dropdown" data-nav-prefix="/cgi-bin/luci/admin/services">
					<a class="menu" href="#"><span class="juliang-nav-glyph" aria-hidden="true"></span><span class="juliang-nav-title">国际互联</span><span class="juliang-nav-chevron" aria-hidden="true">›</span></a>
					<ul class="dropdown-menu">
						<li><a href="{{ dispatcher.build_url('admin','services','passwall2') }}">PassWall2</a></li>
						<li><a href="{{ dispatcher.build_url('admin','services','live') }}">直播 Live</a></li>
						<li><a href="{{ dispatcher.build_url('admin','services','homeproxy') }}">HomeProxy</a></li>
					</ul>
				</li>
				<li class="dropdown" data-nav-prefix="/cgi-bin/luci/admin/network">
					<a class="menu" href="#"><span class="juliang-nav-glyph" aria-hidden="true"></span><span class="juliang-nav-title">网络配置</span><span class="juliang-nav-chevron" aria-hidden="true">›</span></a>
					<ul class="dropdown-menu">
						<li><a href="{{ dispatcher.build_url('admin','network','network') }}">接口</a></li>
						<li><a href="{{ dispatcher.build_url('admin','network','wireless') }}">无线</a></li>
						{% if (!limitedAdmin): %}
						<li><a href="{{ dispatcher.build_url('admin','network','dhcp') }}">DHCP/DNS</a></li>
						<li><a href="{{ dispatcher.build_url('admin','network','arpbind') }}">IP/MAC 绑定</a></li>
						<li><a href="{{ dispatcher.build_url('admin','network','sqm') }}">SQM 队列管理</a></li>
						<li><a href="{{ dispatcher.build_url('admin','network','firewall') }}">防火墙</a></li>
						<li><a href="{{ dispatcher.build_url('admin','network','upnp') }}">UPnP IGD 和 PCP</a></li>
						{% endif %}
					</ul>
				</li>
				<li data-nav-prefix="/cgi-bin/luci/admin/logout">
					<a href="{{ dispatcher.build_url('admin','logout') }}"><span class="juliang-nav-glyph" aria-hidden="true"></span><span class="juliang-nav-title">退出</span></a>
				</li>
			</ul>
			<div class="juliang-sidebar-foot">
				<span>JULIANG NETWORK FABRIC</span>
				<strong>OS 1.5</strong>
			</div>
		</aside>
		<button class="juliang-scrim" id="juliang-scrim" type="button" aria-label="关闭导航"></button>

		<div class="juliang-shell">
			<header class="juliang-appbar">
				<button class="juliang-menu-button" id="juliang-menu-button" type="button" aria-label="打开导航">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
				</button>
				<div class="juliang-breadcrumb">
					<span>JuLiang OS</span>
					<i>/</i>
					<strong>{{ pageTitle }}</strong>
				</div>
				<div class="juliang-appbar-meta">
					<span class="juliang-state"><i></i>策略已生效</span>
					<div id="indicators" class="juliang-indicators"></div>
				</div>
			</header>

			<main id="maincontent" class="container juliang-content">
				{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message warning">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				{% if (boardinfo?.rootfs_type == 'initramfs'): %}
					<div class="alert-message warning">
						<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
						<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
						{% if (dispatcher.lookup("admin/system/flash")): %}
						  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				<noscript>
					<div class="alert-message warning">
						<h4>{{ _('JavaScript required!') }}</h4>
						<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
					</div>
				</noscript>

				<div id="tabmenu" class="juliang-tabmenu" style="display:none"></div>
		{% endif %}
		<script defer src="{{ media }}/status-r4.js?v=1.5-r4"></script>
