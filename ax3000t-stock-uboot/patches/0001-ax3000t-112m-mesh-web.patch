@@ -6,8 +6,10 @@
  * Author: Weijie Gao <weijie.gao@mediatek.com>
  *
  * Generic image booting command
  */
 
+#include <button.h>
+#include <vsprintf.h>
 #include <command.h>
 #include <linux/types.h>
 
@@ -15,8 +16,23 @@
+static int button_is_pressed(const char *label)
+{
+	struct udevice *button;
+
+	return !button_get_by_label(label, &button) &&
+	       button_get_state(button) == BUTTON_ON;
+}
+
 static int do_mtkboardboot(struct cmd_tbl *cmdtp, int flag, int argc,
 			   char *const argv[])
 {
 	int ret = CMD_RET_SUCCESS;
 
+	if (IS_ENABLED(CONFIG_MTK_WEB_FAILSAFE) &&
+	    (button_is_pressed("mesh") || button_is_pressed("reset"))) {
+		printf("Mesh or reset button pressed, starting Web failsafe\n");
+		run_command("httpd", 0);
+		return CMD_RET_SUCCESS;
+	}
+
 	ret = board_boot_default();
 	if (ret)
 		ret = CMD_RET_FAILURE;
