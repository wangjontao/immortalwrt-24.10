#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
# rc.local starts this service after the normal boot service sequence.
boot() { return 0; }
start_service() {
    [ -e /etc/ap20-supplied-config-v2.done ] && return 0
    procd_open_instance
    procd_set_param command /bin/sh /root/ap20-firstboot.sh
    procd_set_param term_timeout 10
    procd_close_instance
}