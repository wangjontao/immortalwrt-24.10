new file mode 100644
index 0000000000000000000000000000000000000000..f41159008ba6fda78bb6dd7bc23f9702207c8690
--- /dev/null
+++ b/luci-app-ssr-plus/root/usr/share/shadowsocksr/gen_singbox_anytls.lua
@@ -0,0 +1,101 @@
+#!/usr/bin/lua
+
+local ucursor = require "luci.model.uci".cursor()
+local json = require "luci.jsonc"
+
+local section = arg[1]
+local local_port = tonumber(arg[2])
+local socks_port = tonumber(arg[3]) or 0
+local inbound_type = arg[4] or "redirect"
+
+assert(section and local_port, "usage: gen_singbox_anytls.lua <section> <local_port> [socks_port] [redirect|tproxy]")
+assert(inbound_type == "redirect" or inbound_type == "tproxy", "unsupported inbound type: " .. inbound_type)
+
+local server = ucursor:get_all("shadowsocksr", section)
+assert(server and server.v2ray_protocol == "anytls", "node is not AnyTLS")
+assert(server.server and server.server ~= "", "AnyTLS server is required")
+assert(tonumber(server.server_port), "AnyTLS server port is required")
+assert(server.password and server.password ~= "", "AnyTLS password is required")
+
+local function enabled(value)
+	return value == "1" or value == true
+end
+
+local function split_csv(value)
+	local result = {}
+	for item in (value or ""):gmatch("[^,]+") do
+		item = item:match("^%s*(.-)%s*$")
+		if item ~= "" then
+			result[#result + 1] = item
+		end
+	end
+	return #result > 0 and result or nil
+end
+
+local function seconds(value, default)
+	local number = tonumber(value)
+	return tostring(number or default) .. "s"
+end
+
+local listen_address = (ucursor:get_first("shadowsocksr", "global", "ipv6_support", "0") == "1")
+	and "::" or "0.0.0.0"
+local inbounds = {
+	{
+		type = inbound_type,
+		tag = "in",
+		listen = listen_address,
+		listen_port = local_port
+	}
+}
+
+if inbound_type == "tproxy" then
+	inbounds[1].network = "udp"
+end
+
+if socks_port > 0 then
+	inbounds[#inbounds + 1] = {
+		type = "socks",
+		tag = "socks-in",
+		listen = listen_address,
+		listen_port = socks_port
+	}
+end
+
+local tls = {
+	enabled = true,
+	server_name = (server.tls_host and server.tls_host ~= "") and server.tls_host or server.server,
+	insecure = enabled(server.insecure),
+	alpn = split_csv(server.tls_alpn)
+}
+
+local anytls = {
+	type = "anytls",
+	tag = "proxy",
+	server = server.server,
+	server_port = tonumber(server.server_port),
+	password = server.password,
+	idle_session_check_interval = seconds(server.anytls_idle_session_check_interval, 30),
+	idle_session_timeout = seconds(server.anytls_idle_session_timeout, 30),
+	min_idle_session = tonumber(server.anytls_min_idle_session) or 0,
+	tls = tls,
+	tcp_fast_open = enabled(server.fast_open)
+}
+
+local config = {
+	log = {
+		level = "warn"
+	},
+	inbounds = inbounds,
+	outbounds = {
+		anytls,
+		{
+			type = "direct",
+			tag = "direct"
+		}
+	},
+	route = {
+		final = "proxy"
+	}
+}
+
+print(json.stringify(config, 1))
