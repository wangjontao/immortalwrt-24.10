index 0000000000000000000000000000000000000000..f07db5b34677428ce8621701ba6ecd350d33389f
--- /dev/null
+++ b/luci-app-ssr-plus/root/usr/share/shadowsocksr/gen_singbox_anytls_server.lua
@@ -0,0 +1,53 @@
+#!/usr/bin/lua
+
+local ucursor = require "luci.model.uci".cursor()
+local json = require "luci.jsonc"
+
+local section = arg[1]
+assert(section, "usage: gen_singbox_anytls_server.lua <section>")
+
+local server = ucursor:get_all("shadowsocksr", section)
+assert(server and server.type == "anytls", "node is not an AnyTLS server")
+assert(tonumber(server.server_port), "AnyTLS server port is required")
+assert(server.anytls_password and server.anytls_password ~= "", "AnyTLS password is required")
+assert(server.tls_certificateFile and server.tls_certificateFile ~= "", "TLS certificate is required")
+assert(server.tls_keyFile and server.tls_keyFile ~= "", "TLS private key is required")
+
+local padding = {}
+for line in (server.anytls_padding or ""):gmatch("[^\r\n]+") do
+	padding[#padding + 1] = line
+end
+
+local config = {
+	log = {
+		level = "warn"
+	},
+	inbounds = {
+		{
+			type = "anytls",
+			tag = "anytls-in",
+			listen = "::",
+			listen_port = tonumber(server.server_port),
+			users = {
+				{
+					name = "user",
+					password = server.anytls_password
+				}
+			},
+			padding_scheme = #padding > 0 and padding or nil,
+			tls = {
+				enabled = true,
+				certificate_path = server.tls_certificateFile,
+				key_path = server.tls_keyFile
+			}
+		}
+	},
+	outbounds = {
+		{
+			type = "direct",
+			tag = "direct"
+		}
+	}
+}
+
+print(json.stringify(config, 1))
