<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>JuliangTK 登录</title><link rel="stylesheet" href="/luci-static/juliangtk/console.css"></head><body><main style="max-width:420px;margin:10vh auto;padding:24px"><h1>JuliangTK</h1><p>海外业务管理台</p><form method="post" style="background:white;padding:26px;border-radius:14px;border:1px solid #e4e8ef">{% if (fuser): %}<p style="color:#d44359">用户名或密码错误，请重试。</p>{% endif %}<label>账号<input type="text" name="luci_username" autocomplete="username" required style="display:block;width:100%;margin:8px 0 18px"></label><label>密码<input type="password" name="luci_password" autocomplete="current-password" required style="display:block;width:100%;margin:8px 0 22px"></label><button type="submit" class="cbi-button-apply" style="width:100%">登录</button></form></main></body></html>
