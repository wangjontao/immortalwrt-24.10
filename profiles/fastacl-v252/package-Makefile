include $(TOPDIR)/rules.mk
PKG_NAME:=fastacl252
PKG_VERSION:=2.5.2-dev.1
PKG_RELEASE:=1
PKG_LICENSE:=AGPL-3.0-only
include $(INCLUDE_DIR)/package.mk
define Package/fastacl252
  SECTION:=net
  CATEGORY:=Network
  TITLE:=JuLiangTK FastACL device proxy console
  CONFLICTS:=fastacl25 fastacl251
  DEPENDS:=+juliangtk-dae +luci-compat +luci-lib-nixio +luci-lib-jsonc +lyaml +curl +ca-bundle +ip-full +firewall4
endef
define Build/Compile
endef
define Package/fastacl252/install
	$(CP) ./files/* $(1)/
	chmod 755 $(1)/usr/bin/fastacl252-dns $(1)/usr/bin/fastacl252 $(1)/usr/libexec/fastacl252-enable.sh $(1)/etc/init.d/fastacl252 $(1)/etc/hotplug.d/iface/99-fastacl252
	chmod 600 $(1)/etc/config/fastacl252
endef
$(eval $(call BuildPackage,fastacl252))
