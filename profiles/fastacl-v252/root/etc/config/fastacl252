config main 'main'
	option version '2.6.6'
	option provisioned '0'
	option enabled '0'
	option fixed_exit '0'
	option network 'lan'
	option port '12525'
	option capacity_profile 'auto'
	option data_max_connections 'auto'
	option data_max_connections_per_session 'auto'
	option tcp_idle_timeout '300s'
	option tcp_half_close_timeout '30s'
	option default_mode 'direct'
	option direct_dns 'alidns'
	option proxy_dns 'cloudflare'
	option max_wifi_5g '14'
	option max_wifi_2g '8'
	# Legacy resolver fields are kept for rollback/test compatibility.
	option dns_policy 'private'
	option dns_server '223.5.5.5'
	option dns_name 'dns.alidns.com'
	option private_dns_server '1.1.1.1'
	option private_dns_name 'cloudflare-dns.com'
