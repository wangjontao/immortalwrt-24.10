#!/bin/sh /etc/rc.common

USE_PROCD=1
START=97
STOP=8

start_service(){
  [ "$(uci -q get wan-watchdog.main.enabled 2>/dev/null || echo 1)" = 1 ] || return 0
  procd_open_instance
  procd_set_param command /usr/bin/wan-watchdog run
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

reload_service(){
  if [ "$(uci -q get wan-watchdog.main.enabled 2>/dev/null || echo 1)" = 1 ]; then
    start
  else
    stop
  fi
}

service_triggers(){
  procd_add_reload_trigger wan-watchdog
}
