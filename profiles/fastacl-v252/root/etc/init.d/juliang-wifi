#!/bin/sh /etc/rc.common
# Applies the tuned RAX3000M NAND wireless layout after radio detection.
#
# Doing this in /etc/uci-defaults was fragile: the radios always exist only
# after /etc/init.d/wifi has run its detect pass, so on a fresh image the
# wireless sections were not there yet and the SSID/band settings were lost.
# Running at boot, after wifi (START=19), means the sections are always present,
# and a firmware upgrade that regenerates /etc/config/wireless is re-applied too.

START=95
STOP=95

LOG='/etc/juliang-wifi.log'
MAIN_KEY='66668888'
LIVE_KEY='66668888'

log() { echo "[$(date +%H:%M:%S)] $*" >> "$LOG" 2>/dev/null; }

radio_list() {
    uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p'
}

start() {
    : > "$LOG" 2>/dev/null || true
    [ -x /sbin/wifi ] || { log "no /sbin/wifi, nothing to do"; return 0; }

    # Make sure the radios exist; wifi config only fills in what is missing.
    if [ -z "$(radio_list)" ]; then
        /sbin/wifi config >> "$LOG" 2>&1 || log "wifi config failed"
    fi

    radios="$(radio_list)"
    if [ -z "$radios" ]; then
        log "no wifi-device sections, giving up"
        return 0
    fi
    log "radios: $(echo $radios)"

    # Tune radios once. Later user-selected channels and widths must persist.
    if [ "$(uci -q get fastacl252.main.wifi_tuning)" != '1.5' ]; then
        for r in $radios; do
            case "$r" in
                radio0)
                    uci set wireless.$r.band='2g'     || log "set $r band failed"
                    uci set wireless.$r.channel='1'   || log "set $r channel failed"
                    uci set wireless.$r.htmode='HE20' || log "set $r htmode failed"
                    ;;
                radio1)
                    uci set wireless.$r.band='5g'      || log "set $r band failed"
                    uci set wireless.$r.channel='36'   || log "set $r channel failed"
                    uci set wireless.$r.htmode='HE80'  || log "set $r htmode failed"
                    ;;
            esac
            uci set wireless.$r.country='CN'   || log "set $r country failed"
            uci set wireless.$r.disabled='0'   || log "enable $r failed"
        done
        uci set fastacl252.main.wifi_tuning='1.5'
        uci commit fastacl252
    fi

    mk_iface() {
        name="$1"; dev="$2"; net="$3"; ssid="$4"; key="$5"; hidden="$6"
        if [ "$(uci -q get wireless.$name)" = 'wifi-iface' ]; then
            uci set wireless.$name.disabled='0'
            return 0
        fi
        uci set wireless.$name='wifi-iface'           || return 0
        uci set wireless.$name.device="$dev"
        uci set wireless.$name.network="$net"
        uci set wireless.$name.mode='ap'
        uci set wireless.$name.ssid="$ssid"
        uci set wireless.$name.encryption='psk2+ccmp'
        uci set wireless.$name.key="$key"
        uci set wireless.$name.disabled='0'
        uci set wireless.$name.hidden="$hidden"
        if [ "$net" = 'jfa25w1' ]; then
            uci set wireless.$name.isolate='0'
            uci set wireless.$name.jfa25_owner='fastacl252-dev2'
            uci set wireless.$name.jfa25_network='jfa25w1'
        fi
        return 0
    }

    # Remove legacy names only when the current replacement already exists.
    [ "$(uci -q get wireless.default_radio0)" = 'wifi-iface' ] &&
        uci -q delete wireless.main24
    [ "$(uci -q get wireless.default_radio1)" = 'wifi-iface' ] &&
        uci -q delete wireless.main5
    [ "$(uci -q get wireless.live24g)" = 'wifi-iface' ] &&
        uci -q delete wireless.live24

    # Keep the section names used by the tuned device so upgrades are idempotent.
    case "$radios" in *radio0*) mk_iface default_radio0 radio0 lan     'JuLiang-OS-2.4G' "$MAIN_KEY" '0';; esac
    case "$radios" in *radio1*) mk_iface default_radio1 radio1 lan     'JuLiang-OS-5G'   "$MAIN_KEY" '1';; esac
    case "$radios" in *radio0*) mk_iface live24g        radio0 jfa25w1 'Live-2.4G'        "$LIVE_KEY" '1';; esac
    case "$radios" in *radio1*) mk_iface live5g         radio1 jfa25w1 'Live-5G'          "$LIVE_KEY" '0';; esac

    uci commit wireless >> "$LOG" 2>&1 || log "commit wireless failed"
    /sbin/wifi reload >> "$LOG" 2>&1 || log "wifi reload failed"
    log "wireless layout applied"
}

stop() { :; }
