#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=9

ensure_http_timeout(){
  local changed=0 value
  value=$(uci -q get uhttpd.main.script_timeout 2>/dev/null || echo 0)
  if [ "$value" -lt 180 ] 2>/dev/null; then
    uci set uhttpd.main.script_timeout='180'
    changed=1
  fi
  value=$(uci -q get uhttpd.main.network_timeout 2>/dev/null || echo 0)
  if [ "$value" -lt 120 ] 2>/dev/null; then
    uci set uhttpd.main.network_timeout='120'
    changed=1
  fi
  if [ "$changed" = 1 ]; then
    uci commit uhttpd
    /etc/init.d/uhttpd reload >/dev/null 2>&1 || true
  fi
}

start_service(){
  ensure_http_timeout
  lua /usr/libexec/juliang-menu-cleanup.lua >/tmp/juliang-menu-cleanup.log 2>&1 ||
    logger -t juliang-menu-cleanup 'menu migration failed'
  lua /usr/libexec/juliang-login-theme.lua >/tmp/juliang-login-theme.log 2>&1 ||
    logger -t juliang-login-theme 'login theme migration failed'
  [ "$(uci -q get fastacl252.main.enabled)" = 1 ] || return 0
  procd_open_instance
  procd_set_param command /usr/bin/fastacl252 guard
  procd_set_param respawn 3600 5 5
  procd_close_instance
}

stop_service(){
  /usr/bin/fastacl252 stop
}

reload_service(){
  [ "$(uci -q get fastacl252.main.enabled)" = 1 ] || return 0
  /usr/bin/fastacl252 hot-apply >/tmp/fastacl252/reload-service.log 2>&1 || return 1
}

service_triggers(){
  # Only FastACL configuration changes are hot-reloaded here.  A normal fw4
  # restart must not restart sing-box or race with a user node switch.
  procd_add_reload_trigger fastacl252
}
