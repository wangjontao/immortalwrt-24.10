#!/bin/sh
set -eu

provisioned="$(uci -q get fastacl252.main.provisioned || true)"
if [ "$provisioned" != 0 ]; then
	uci set 'fastacl252.main.version=2.8.6'
	uci set 'fastacl252.main.dataplane=singbox'
	uci set 'fastacl252.main.auto_timezone=1'
	uci set 'fastacl252.main.max_wifi_5g=14'
	uci set 'fastacl252.main.max_wifi_2g=10'
	uci set 'fastacl252.main.provisioned=1'
	uci set 'system.@system[0].hostname=JuLiang-OS'
	uci set 'luci.main.mediaurlbase=/luci-static/argon'
	uci set 'luci.main.lang=zh_cn'
	uci commit fastacl252
	uci commit system
	uci commit luci
	/etc/init.d/fastacl252 enable
	/etc/init.d/wan-watchdog enable
	exit 0
fi

uci set 'system.@system[0].hostname=JuLiang-OS'
uci set 'luci.main.mediaurlbase=/luci-static/argon'
uci set 'luci.main.lang=zh_cn'
uci set 'network.lan.ipaddr=192.168.7.1'
uci set 'network.lan.netmask=255.255.255.0'
uci commit system; uci commit network; uci commit luci
for radio in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
  band=$(uci -q get "wireless.$radio.band" || true)
  uci set "wireless.$radio.disabled=0"
  case "$band" in
    5g|5ghz)
      uci set "wireless.$radio.channel=36"
      uci set "wireless.$radio.htmode=HE80"
      uci set "wireless.$radio.country=CN"
      ;;
    2g|2.4g|2ghz)
      uci set "wireless.$radio.channel=1"
      uci set "wireless.$radio.htmode=HE20"
      uci set "wireless.$radio.country=CN"
      ;;
  esac
done
for iface in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
  case "$iface" in
    default_radio0|main24)
      uci set "wireless.$iface.ssid=JuLiang-OS-2.4G"
      uci set "wireless.$iface.hidden=0"
      uci set "wireless.$iface.network=lan"
      ;;
    default_radio1|main5)
      uci set "wireless.$iface.ssid=JuLiang-OS-5G"
      uci set "wireless.$iface.hidden=1"
      uci set "wireless.$iface.network=lan"
      ;;
    live24g|live24)
      uci set "wireless.$iface.ssid=Live-2.4G"
      uci set "wireless.$iface.hidden=1"
      uci set "wireless.$iface.network=jfa25w1"
      uci set "wireless.$iface.jfa25_owner=fastacl252-dev2"
      uci set "wireless.$iface.jfa25_network=jfa25w1"
      ;;
    live5g)
      uci set "wireless.$iface.ssid=Live-5G"
      uci set "wireless.$iface.hidden=0"
      uci set "wireless.$iface.network=jfa25w1"
      uci set "wireless.$iface.jfa25_owner=fastacl252-dev2"
      uci set "wireless.$iface.jfa25_network=jfa25w1"
      ;;
    *)
      continue
      ;;
  esac
  uci set "wireless.$iface.encryption=psk2+ccmp"
  uci set "wireless.$iface.key=66668888"
  uci set "wireless.$iface.disabled=0"
done
uci commit wireless
uci set 'dropbear.@dropbear[0].Port=20022'; uci commit dropbear
uci set 'fastacl252.main.fixed_exit=0'
uci set 'fastacl252.main.version=2.8.6'
uci set 'fastacl252.main.dataplane=singbox'
uci set 'fastacl252.main.auto_timezone=1'
uci set 'fastacl252.main.max_wifi_5g=14'
uci set 'fastacl252.main.max_wifi_2g=10'
uci set 'fastacl252.main.provisioned=1'; uci commit fastacl252
/usr/libexec/fastacl252-enable.sh --config-only
/etc/init.d/fastacl252 enable
/etc/init.d/wan-watchdog enable
exit 0
