#!/bin/sh
set -eu

provisioned="$(uci -q get fastacl252.main.provisioned || true)"
if [ "$provisioned" != 0 ]; then
	uci set 'fastacl252.main.version=2.7.1'
	uci set 'fastacl252.main.dataplane=ebpf'
	uci set 'fastacl252.main.provisioned=1'
	uci commit fastacl252
	/etc/init.d/fastacl252 enable
	/etc/init.d/wan-watchdog enable
	exit 0
fi

uci set 'system.@system[0].hostname=JuLiangTK-S20L'
uci set 'network.lan.ipaddr=192.168.7.1'
uci set 'network.lan.netmask=255.255.255.0'
uci commit system; uci commit network
for radio in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
  band=$(uci -q get "wireless.$radio.band" || true)
  uci set "wireless.$radio.disabled=0"
  case "$band" in
    5g|5ghz)
      uci set "wireless.$radio.channel=36"
      uci set "wireless.$radio.htmode=HE80"
      uci set "wireless.$radio.country=CN"
      ;;
    2g|2.4g|2ghz)
      uci set "wireless.$radio.channel=1"
      uci set "wireless.$radio.htmode=HE20"
      uci set "wireless.$radio.country=CN"
      ;;
  esac
done
for iface in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
  uci set "wireless.$iface.ssid=JuLiangTK"
  uci set "wireless.$iface.network=lan"
  uci set "wireless.$iface.encryption=psk2+ccmp"
  uci set "wireless.$iface.key=a1111111"
  uci set "wireless.$iface.disabled=0"
done
uci commit wireless
uci set 'dropbear.@dropbear[0].Port=20022'; uci commit dropbear
uci set 'fastacl252.main.fixed_exit=0'
uci set 'fastacl252.main.version=2.7.1'
uci set 'fastacl252.main.dataplane=ebpf'
uci set 'fastacl252.main.provisioned=1'; uci commit fastacl252
/usr/libexec/fastacl252-enable.sh --config-only
/etc/init.d/fastacl252 enable
/etc/init.d/wan-watchdog enable
exit 0
