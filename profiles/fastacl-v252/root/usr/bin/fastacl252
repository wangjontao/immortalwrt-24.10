#!/bin/sh
set -eu
umask 077

R=${FASTACL_RUNTIME_DIR:-/tmp/fastacl252}
HEALTH_LOG=${FASTACL_HEALTH_LOG:-/root/fastacl252-health.log}
LOCK="${R}-apply.lock"
SOCKS_BACKLOG_LIMIT=${FASTACL_SOCKS_BACKLOG_LIMIT:-128}
DAE_FD_LIMIT=${FASTACL_DAE_FD_LIMIT:-}
DNS_FD_LIMIT=${FASTACL_DNS_FD_LIMIT:-}
RECOVERY_COOLDOWN=${FASTACL_RECOVERY_COOLDOWN:-120}
PROBE_FAILURE_LIMIT=${FASTACL_PROBE_FAILURE_LIMIT:-2}
FD_HARD_LIMIT=
FD_SOFT_LIMIT=
CAPACITY_PROFILE=
DAE_TCP_RELAY_IDLE_TIMEOUT=$(uci -q get fastacl252.main.tcp_idle_timeout 2>/dev/null || true)
case "$DAE_TCP_RELAY_IDLE_TIMEOUT" in
  [0-9]s|[0-9][0-9]s|[0-9][0-9][0-9]s) ;;
  *) DAE_TCP_RELAY_IDLE_TIMEOUT=300s ;;
esac
DAE_TCP_RELAY_HALF_CLOSE_TIMEOUT=$(uci -q get fastacl252.main.tcp_half_close_timeout 2>/dev/null || true)
case "$DAE_TCP_RELAY_HALF_CLOSE_TIMEOUT" in
  [0-9]s|[0-9][0-9]s|[0-9][0-9][0-9]s) ;;
  *) DAE_TCP_RELAY_HALF_CLOSE_TIMEOUT=30s ;;
esac
mkdir -p "$R"

detect_capacity(){
  local mem_kb cpus profile
  mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  cpus=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
  profile=${FASTACL_CAPACITY_PROFILE:-$(uci -q get fastacl252.main.capacity_profile 2>/dev/null || true)}
  if [ "$profile" = auto ] || [ -z "$profile" ]; then
    if [ "$cpus" -ge 4 ] && [ "$mem_kb" -ge 1800000 ]; then
      profile=high
    elif [ "$cpus" -ge 4 ] && [ "$mem_kb" -ge 900000 ]; then
      profile=quad
    elif [ "$cpus" -ge 2 ] && [ "$mem_kb" -ge 900000 ]; then
      profile=balanced
    else
      profile=compact
    fi
  fi
  case "$profile" in
    high)
      FD_HARD_LIMIT=65536; FD_SOFT_LIMIT=61440
      [ -n "$DAE_FD_LIMIT" ] || DAE_FD_LIMIT=57344
      [ -n "$DNS_FD_LIMIT" ] || DNS_FD_LIMIT=57344
      ;;
    quad)
      FD_HARD_LIMIT=49152; FD_SOFT_LIMIT=45056
      [ -n "$DAE_FD_LIMIT" ] || DAE_FD_LIMIT=43008
      [ -n "$DNS_FD_LIMIT" ] || DNS_FD_LIMIT=43008
      ;;
    balanced)
      FD_HARD_LIMIT=40960; FD_SOFT_LIMIT=38912
      [ -n "$DAE_FD_LIMIT" ] || DAE_FD_LIMIT=36000
      [ -n "$DNS_FD_LIMIT" ] || DNS_FD_LIMIT=36000
      ;;
    *)
      profile=compact
      FD_HARD_LIMIT=24576; FD_SOFT_LIMIT=22528
      [ -n "$DAE_FD_LIMIT" ] || DAE_FD_LIMIT=20480
      [ -n "$DNS_FD_LIMIT" ] || DNS_FD_LIMIT=20480
      ;;
  esac
  CAPACITY_PROFILE=$profile
}

detect_capacity

raise_nofile(){
  case "$CAPACITY_PROFILE" in
    high)
      [ "$(cat /proc/sys/fs/file-max 2>/dev/null || echo 0)" -ge 200000 ] ||
        sysctl -w fs.file-max=200000 >/dev/null 2>&1 || true
      ;;
    quad)
      [ "$(cat /proc/sys/fs/file-max 2>/dev/null || echo 0)" -ge 150000 ] ||
        sysctl -w fs.file-max=150000 >/dev/null 2>&1 || true
      ;;
  esac
  ulimit -Hn "$FD_HARD_LIMIT" 2>/dev/null || true
  ulimit -Sn "$FD_SOFT_LIMIT" 2>/dev/null || true
}

pause_fast(){
  sleep 0.1 2>/dev/null && return 0
  command -v usleep >/dev/null 2>&1 && { usleep 100000; return 0; }
  sleep 1
}

release_lock(){
  [ -s "$LOCK/pid" ] || return 0
  [ "$(cat "$LOCK/pid" 2>/dev/null || true)" = "$$" ] || return 0
  rm -rf "$LOCK" 2>/dev/null || true
}

acquire_lock(){
  local i=0 owner=''
  while ! mkdir "$LOCK" 2>/dev/null; do
    owner=$(cat "$LOCK/pid" 2>/dev/null || true)
    case "$owner" in
      ''|*[!0-9]*)
        if [ $(( $(date +%s) - $(stat -c %Y "$LOCK" 2>/dev/null || date +%s) )) -gt 10 ]; then
          rm -rf "$LOCK" 2>/dev/null || true
          continue
        fi;;
      *)
        if ! kill -0 "$owner" 2>/dev/null; then
          rm -rf "$LOCK" 2>/dev/null || true
          continue
        fi;;
    esac
    i=$((i+1))
    [ "$i" -lt 30 ] || { echo 'FastACL apply busy' >&2; return 1; }
    pause_fast
  done
  printf '%s\n' "$$" > "$LOCK/pid"
  trap 'release_lock' EXIT
  trap 'exit 130' INT
  trap 'exit 143' HUP TERM
}

alive(){
  [ -s "$R/router.pid" ] || return 1
  local pid; pid=$(cat "$R/router.pid" 2>/dev/null || true)
  case "$pid" in ''|*[!0-9]*) return 1;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq "$R/router.dae"
}

dns_alive(){
  [ -s "$R/dns.pid" ] || return 1
  local pid; pid=$(cat "$R/dns.pid" 2>/dev/null || true)
  case "$pid" in ''|*[!0-9]*) return 1;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq 'fastacl252-dns'
}

listener(){
  (ss -lnt 2>/dev/null || netstat -lnt 2>/dev/null) | grep -q ":$1 "
}

socks_backlog(){
  (ss -lnt 2>/dev/null || netstat -lnt 2>/dev/null) |
    awk '$4 == "127.0.0.1:15443" { print $2; exit }'
}

socks_connections(){
  netstat -ant 2>/dev/null |
    awk '$4 == "127.0.0.1:15443" && $6 == "ESTABLISHED" { count++ } END { print count+0 }'
}

socks_ready(){
  local backlog
  backlog=$(socks_backlog)
  [ -n "$backlog" ] && [ "$backlog" -le "$SOCKS_BACKLOG_LIMIT" ]
}

dae_ready(){
  alive || return 1
  local port; port=$(uci -q get fastacl252.main.port 2>/dev/null || echo 12345)
  (ip netns exec daens ss -lntu 2>/dev/null || ip netns exec daens netstat -lntu 2>/dev/null) | grep -q ":$port "
}

dns_guard_ready(){
  nft list chain inet fastacl252 dns_redirect 2>/dev/null |
    grep -Fq 'redirect to :12553' &&
  nft list chain inet fastacl252 forward 2>/dev/null |
    grep -Fq 'th dport 53 drop'
}

dns_ready(){ dns_alive && listener 12553 && socks_ready && dns_guard_ready; }

pid_fd_count(){
  [ -d "/proc/$1/fd" ] && ls "/proc/$1/fd" 2>/dev/null | wc -l
}

runtime_failure(){
  local pid
  alive || { echo dae-process; return; }
  dns_alive || { echo dns-process; return; }
  listener 12553 || { echo dns-listener; return; }
  dns_guard_ready || { echo dns-guard; return; }
  socks_ready || { echo "socks-backlog:$(socks_backlog)"; return; }
  dae_ready || { echo dae-listener; return; }
  nft list table inet fastacl252 >/dev/null 2>&1 || { echo nft-table; return; }

  pid=$(cat "$R/router.pid" 2>/dev/null || true)
  [ "$(pid_fd_count "$pid")" -lt "$DAE_FD_LIMIT" ] ||
    { echo "dae-fd:$(pid_fd_count "$pid")"; return; }
  pid=$(cat "$R/dns.pid" 2>/dev/null || true)
  [ "$(pid_fd_count "$pid")" -lt "$DNS_FD_LIMIT" ] ||
    { echo "dns-fd:$(pid_fd_count "$pid")"; return; }
}

health_log(){
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$HEALTH_LOG"
  if [ "$(wc -c < "$HEALTH_LOG")" -gt 65536 ]; then
    tail -n 400 "$HEALTH_LOG" > "$HEALTH_LOG.next"
    mv "$HEALTH_LOG.next" "$HEALTH_LOG"
  fi
}

socks_probe(){
  local url
  command -v curl >/dev/null 2>&1 || return 0
  url=$(grep -m1 -oE "socks5://[^']*@127\.0\.0\.1:15443" "$R/router.dae" 2>/dev/null || true)
  [ -n "$url" ] || return 0
  curl -x "$url" -sS -o /dev/null --connect-timeout 3 --max-time 8 \
    https://1.1.1.1/ >/dev/null 2>&1
}

health_snapshot(){
  local dae_pid dns_pid dae_fd dns_fd backlog connections stats
  dae_pid=$(cat "$R/router.pid" 2>/dev/null || true)
  dns_pid=$(cat "$R/dns.pid" 2>/dev/null || true)
  dae_fd=$(pid_fd_count "$dae_pid")
  dns_fd=$(pid_fd_count "$dns_pid")
  backlog=$(socks_backlog)
  connections=$(socks_connections)
  stats=$(fastacl252-dns -stats -config "$R/dns.json" 2>/dev/null | head -n 1 || true)
  health_log "healthy=yes socks_backlog=${backlog:-none} socks_connections=${connections:-none} dae_fd=${dae_fd:-none} dns_fd=${dns_fd:-none} stats=${stats:-none}"
}

wait_dae(){
  local i=0
  while ! dae_ready; do
    i=$((i+1)); [ "$i" -lt 40 ] || return 1
    pause_fast
  done
}

wait_dns(){
  local i=0
  while ! dns_ready; do
    i=$((i+1)); [ "$i" -lt 30 ] || return 1
    pause_fast
  done
}

dns_stop(){
  if dns_alive; then
    kill "$(cat "$R/dns.pid")" 2>/dev/null || true
    local i=0
    while dns_alive; do
      i=$((i+1)); [ "$i" -lt 20 ] || { kill -9 "$(cat "$R/dns.pid")" 2>/dev/null || true; break; }
      pause_fast
    done
  fi
  rm -f "$R/dns.pid"
}

dae_stop(){
  if alive; then
    kill "$(cat "$R/router.pid")" 2>/dev/null || true
    local i=0
    while alive; do
      i=$((i+1)); [ "$i" -lt 25 ] || { kill -9 "$(cat "$R/router.pid")" 2>/dev/null || true; break; }
      pause_fast
    done
  fi
  rm -f "$R/router.pid"
}

generate_guards(){
  lua /usr/libexec/fastacl252-generate.lua nft guard
  firewall_apply
}

generate_next(){
  lua /usr/libexec/fastacl252-generate.lua nft
}

validate_next(){
  dae validate -c "$R/router.next.dae" >"$R/check.log" 2>&1 || { cat "$R/check.log"; return 1; }
  fastacl252-dns -check -config "$R/dns.next.json" >"$R/dns-check.log" 2>&1 || { cat "$R/dns-check.log"; return 1; }
}

firewall_apply(){
  if ! cmp -s "$R/nft.next.rules" "$R/nft.loaded.rules" || ! nft list table inet fastacl252 >/dev/null 2>&1; then
    {
      nft list table inet fastacl252 >/dev/null 2>&1 && echo 'delete table inet fastacl252' || true
      cat "$R/nft.next.rules"
    } > "$R/nft.apply"
    nft -c -f "$R/nft.apply"
    nft -f "$R/nft.apply"
    cp "$R/nft.next.rules" "$R/nft.loaded.rules"
  fi
}

start_dns_next(){
  cp "$R/dns.next.json" "$R/dns.json"
  fastacl252-dns -config "$R/dns.json" >"$R/dns.log" 2>&1 &
  echo $! > "$R/dns.pid"
  wait_dns || { cat "$R/dns.log" 2>/dev/null || true; return 1; }
}

start_dae_next(){
  cp "$R/router.next.dae" "$R/router.dae"
  DAE_TCP_RELAY_HALF_CLOSE_TIMEOUT="$DAE_TCP_RELAY_HALF_CLOSE_TIMEOUT" \
  DAE_TCP_RELAY_IDLE_TIMEOUT="$DAE_TCP_RELAY_IDLE_TIMEOUT" \
    dae run --disable-pidfile --disable-sudo -c "$R/router.dae" >"$R/router.log" 2>&1 &
  echo $! > "$R/router.pid"
  wait_dae || { cat "$R/router.log" 2>/dev/null || true; return 1; }
}

reload_dns_next(){
  if dns_ready && cmp -s "$R/dns.next.json" "$R/dns.json"; then return 0; fi
  if ! dns_ready; then
    dns_stop
    start_dns_next
    return $?
  fi
  cp "$R/dns.json" "$R/dns.prev.json"
  cp "$R/dns.next.json" "$R/dns.json.pending"
  mv "$R/dns.json.pending" "$R/dns.json"
  if fastacl252-dns -reload -config "$R/dns.json" >"$R/dns-reload.log" 2>&1; then return 0; fi
  echo '[FastACL] DNS reload rejected; keeping the running policy and listener' >&2
  cat "$R/dns-reload.log" >&2
  cp "$R/dns.prev.json" "$R/dns.json.pending"
  mv "$R/dns.json.pending" "$R/dns.json"
  return 1
}

# dae's own reload command can wait up to 60 seconds.  A UI node switch must
# never inherit that latency, so cap the CLI wait to about four seconds.  If
# the in-process reload does not finish, the caller falls back to dae-only
# restart; system network/wifi/firewall are still untouched.
dae_reload_fast(){
  local pid="$1" cli i=0
  : > "$R/reload.log"
  dae reload "$pid" >"$R/reload.log" 2>&1 &
  cli=$!
  while kill -0 "$cli" 2>/dev/null; do
    i=$((i+1))
    if [ "$i" -ge 40 ]; then
      echo '[FastACL] dae reload exceeded 4s fast-path budget' >> "$R/reload.log"
      kill "$cli" 2>/dev/null || true
      wait "$cli" 2>/dev/null || true
      return 124
    fi
    pause_fast
  done
  if wait "$cli"; then return 0; fi
  return 1
}

reload_dae_next(){
  if dae_ready && cmp -s "$R/router.next.dae" "$R/router.dae"; then return 0; fi
  if ! dae_ready; then
    dae_stop
    start_dae_next
    return $?
  fi

  cp "$R/router.dae" "$R/router.prev.dae"
  cp "$R/router.next.dae" "$R/router.dae"
  local pid; pid=$(cat "$R/router.pid")
  if dae_reload_fast "$pid" && wait_dae; then
    echo 'hot' > "$R/last-apply-mode"
    return 0
  fi

  echo '[FastACL] dae hot reload failed/timeout; falling back to dae-only restart' >&2
  cat "$R/reload.log" 2>/dev/null || true
  dae_stop
  if start_dae_next; then
    echo 'app-restart' > "$R/last-apply-mode"
    return 0
  fi

  echo '[FastACL] new dae config failed; rolling back previous application config' >&2
  dae_stop
  if [ -s "$R/router.prev.dae" ]; then
    cp "$R/router.prev.dae" "$R/router.next.dae"
    start_dae_next || true
  fi
  return 1
}

hot_apply(){
  raise_nofile
  acquire_lock
  generate_guards
  generate_next
  validate_next
  firewall_apply
  reload_dns_next
  reload_dae_next
  echo 'hot' > "$R/last-request-mode"
}

cold_apply(){
  raise_nofile
  acquire_lock
  # Install fail-close guards even if a saved proxy configuration is invalid.
  generate_guards
  generate_next
  validate_next
  firewall_apply
  dae_stop
  dns_stop
  start_dns_next
  start_dae_next
  echo 'cold' > "$R/last-request-mode"
  echo 'app-restart' > "$R/last-apply-mode"
}

ensure_runtime(){
  if dae_ready && dns_ready && nft list table inet fastacl252 >/dev/null 2>&1; then return 0; fi
  echo '[FastACL] runtime unhealthy; recovering only failed components' >&2
  hot_apply
}

status(){
  local engine=stopped fw=false mode=none request=none
  alive && engine=running
  [ "$engine" != running ] || dns_ready || engine=broken
  [ "$engine" != running ] || dae_ready || engine=broken
  nft list table inet fastacl252 >/dev/null 2>&1 && fw=true
  [ ! -s "$R/last-apply-mode" ] || mode=$(cat "$R/last-apply-mode")
  [ ! -s "$R/last-request-mode" ] || request=$(cat "$R/last-request-mode")
  printf '{"engine":"%s","firewall":%s,"backend":"nft","switch":"%s","request":"%s"}\n' "$engine" "$fw" "$mode" "$request"
}

case "${1:-status}" in
  apply|hot-apply) hot_apply;;
  cold-apply) cold_apply;;
  ensure) ensure_runtime;;
  status) status;;
  health)
    reason=$(runtime_failure 2>/dev/null || true)
    if [ -n "$reason" ]; then
      echo "unhealthy: $reason"
    else
      health_snapshot
      echo healthy
    fi;;
  stop)
    dns_stop
    dae_stop
    echo 'Core stopped; protection rules retained';;
  guard)
    raise_nofile
    failures=0
    probe_failures=0
    last_probe=0
    last_snapshot=0
    while [ "$(uci -q get fastacl252.main.enabled 2>/dev/null || echo 0)" = 1 ]; do
      reason=$(runtime_failure 2>/dev/null || true)
      if [ -n "$reason" ]; then
        failures=$((failures+1))
        health_log "failure=$reason consecutive=$failures"
        if [ "$failures" -ge 2 ]; then
          now=$(date +%s)
          last=$(cat "$R/health.last-recovery" 2>/dev/null || echo 0)
          if [ $((now-last)) -ge "$RECOVERY_COOLDOWN" ]; then
            health_log "recovering runtime after $failures failures"
            echo "$now" > "$R/health.last-recovery"
            /usr/bin/fastacl252 hot-apply >"$R/health.recovery.log" 2>&1 || true
            failures=0
            probe_failures=0
            pause_fast
            sleep 10
          fi
        fi
      else
        [ "$failures" -eq 0 ] || health_log "runtime recovered"
        failures=0
        now=$(date +%s)
        if [ $((now-last_probe)) -ge 60 ]; then
          last_probe=$now
          if socks_probe; then
            probe_failures=0
          else
            probe_failures=$((probe_failures+1))
            health_log "proxy-probe-failed consecutive=$probe_failures"
            if [ "$probe_failures" -ge "$PROBE_FAILURE_LIMIT" ] &&
               ! edit_busy && [ ! -d "$LOCK" ]; then
              recovery_now=$(date +%s)
              probe_recovery_last=$(cat "$R/probe.last-recovery" 2>/dev/null || echo 0)
              if [ $((recovery_now-probe_recovery_last)) -ge "$RECOVERY_COOLDOWN" ]; then
                health_log "recovering DNS proxy after $probe_failures failed probes"
                echo "$recovery_now" > "$R/probe.last-recovery"
                (
                  acquire_lock
                  dns_stop
                  start_dns_next
                ) >"$R/proxy.recovery.log" 2>&1 || true
                probe_failures=0
                pause_fast
                sleep 10
              fi
            fi
          fi
        fi
        if [ $((now-last_snapshot)) -ge 300 ]; then
          health_snapshot
          last_snapshot=$now
        fi
      fi
      if [ ! -d /tmp/fastacl252-subscribe.lock ]; then
        lua /usr/libexec/fastacl252-subscribe.lua due >"$R/subscribe.log" 2>&1 &
      fi
      sleep 10
    done;;
  cleanup)
    dns_stop
    dae_stop
    nft delete table inet fastacl252 2>/dev/null || true
    rm -f "$R/nft.loaded.rules";;
  *)
    echo 'Usage: fastacl252 hot-apply|cold-apply|ensure|status|health|stop|guard|cleanup' >&2
    exit 2;;
esac
