#!/bin/sh
# Validate both generated sing-box policies concurrently; publish nothing on failure.
set -u
umask 077
singbox_config=$1; dns_config=$2; singbox_log=$3; dns_log=$4
singbox_pid=''; dns_pid=''
cleanup(){
  [ -z "$singbox_pid" ] || kill "$singbox_pid" 2>/dev/null || true
  [ -z "$dns_pid" ] || kill "$dns_pid" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap 'cleanup; exit 143' HUP INT TERM
sing-box check -c "$singbox_config" >"$singbox_log" 2>&1 &
singbox_pid=$!
fastacl252-dns -check -config "$dns_config" >"$dns_log" 2>&1 &
dns_pid=$!
singbox_rc=0; dns_rc=0
wait "$singbox_pid" || singbox_rc=$?
singbox_pid=''
wait "$dns_pid" || dns_rc=$?
dns_pid=''
if [ "$singbox_rc" -ne 0 ]; then cat "$singbox_log"; fi
if [ "$dns_rc" -ne 0 ]; then cat "$dns_log"; fi
[ "$singbox_rc" -eq 0 ] && [ "$dns_rc" -eq 0 ]
