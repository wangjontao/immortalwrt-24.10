include $(TOPDIR)/rules.mk

PKG_NAME:=juliangtk-sing-box
PKG_VERSION:=1.12.25
PKG_RELEASE:=1

ifeq ($(ARCH),x86_64)
  SING_BOX_ARCH:=amd64
  PKG_HASH:=a1ec76e2b6b139eb747a1b1ebee7d14b8d4be5a833596cad8070a31ef960301f
else ifeq ($(ARCH),aarch64)
  SING_BOX_ARCH:=arm64
  PKG_HASH:=719b76196c8b31efa636b2d8f669e314547e0da0a5ab38a75e1882d307bbd154
else
  $(error juliangtk-sing-box supports aarch64 and x86_64 only)
endif

PKG_SOURCE:=sing-box-$(PKG_VERSION)-linux-$(SING_BOX_ARCH).tar.gz
PKG_SOURCE_URL:=https://github.com/SagerNet/sing-box/releases/download/v$(PKG_VERSION)
PKG_BUILD_DIR:=$(BUILD_DIR)/sing-box-$(PKG_VERSION)-linux-$(SING_BOX_ARCH)
PKG_LICENSE:=GPL-3.0-only
PKG_LICENSE_FILES:=LICENSE
include $(INCLUDE_DIR)/package.mk

define Package/juliangtk-sing-box
  SECTION:=net
  CATEGORY:=Network
  TITLE:=Pinned official sing-box for FastACL TPROXY/TUN
  DEPENDS:=@(TARGET_mediatek_filogic||TARGET_x86_64)
  CONFLICTS:=sing-box
endef

define Build/Configure
endef

define Build/Compile
endef

define Package/juliangtk-sing-box/install
	$(INSTALL_DIR) $(1)/usr/bin
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/sing-box $(1)/usr/bin/sing-box
endef

$(eval $(call BuildPackage,juliangtk-sing-box))
