include $(TOPDIR)/rules.mk
PKG_NAME:=juliangtk-mihomo
PKG_VERSION:=1.19.32
PKG_RELEASE:=1
PKG_SOURCE:=mihomo-linux-arm64-v$(PKG_VERSION).gz
PKG_SOURCE_URL:=https://github.com/MetaCubeX/mihomo/releases/download/v$(PKG_VERSION)
PKG_HASH:=9dd862e28b46ff7d775f169cceebc28deccaa0a9e804237d421cd2571e0caba0
PKG_BUILD_DIR:=$(BUILD_DIR)/juliangtk-mihomo-$(PKG_VERSION)
PKG_LICENSE:=GPL-3.0-only
include $(INCLUDE_DIR)/package.mk
define Package/juliangtk-mihomo
  SECTION:=net
  CATEGORY:=Network
  TITLE:=Official Mihomo for JuLiangTK ARM64
  DEPENDS:=@TARGET_mediatek_filogic
  CONFLICTS:=mihomo sing-box juliangtk-sing-box
endef
define Build/Prepare
	mkdir -p $(PKG_BUILD_DIR)
	gzip -dc $(DL_DIR)/$(PKG_SOURCE) > $(PKG_BUILD_DIR)/mihomo
endef
define Build/Configure
endef
define Build/Compile
endef
define Package/juliangtk-mihomo/install
	$(INSTALL_DIR) $(1)/usr/bin
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/mihomo $(1)/usr/bin/mihomo
endef
$(eval $(call BuildPackage,juliangtk-mihomo))
